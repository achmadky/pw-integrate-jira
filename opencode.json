{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jira": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-jira"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "{env:JIRA_BASE_URL}",
        "JIRA_USERNAME": "{env:JIRA_USER_EMAIL}",
        "JIRA_API_TOKEN": "{env:JIRA_API_TOKEN}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true
    },
    "aio-tests": {
      "type": "remote",
      "url": "https://tcms-prod-us.aiojiraapps.com/aiotcms-mcp/v1/c26d62cc-e411-43f4-b971-d9426e75eb4c/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:AIO_API_KEY}"
      }
    }
  },
  "permissions": {
    "bash": {
      "deny": [
        "rm -rf /",
        "rm -rf ~",
        "rm -rf .git",
        "git push --force",
        "git push -f",
        "git reset --hard"
      ],
      "confirm": [
        "rm -rf",
        "npm publish",
        "git commit"
      ]
    },
    "write": {
      "confirm": [
        "*.env",
        "*.pem",
        "*.key"
      ]
    }
  },
  "rules": [
    "Never delete important project files, configuration files, or user code without explicit user confirmation.",
    "Always run tests and verify changes before completing tasks.",
    "Do not execute destructive commands or force-pushes."
  ]
}
